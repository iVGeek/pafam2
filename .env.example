# Render PostgreSQL connection string (internal or external URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Random 32+ character secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-value"

# Initial admin password applied by `prisma db seed` (only if the admin has no
# password yet — a changed password is never overwritten on redeploy).
ADMIN_PASSWORD="change-me"
